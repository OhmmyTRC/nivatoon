{
  "name": "figma-make-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const {spawn}=require('child_process'); const args=['./node_modules/next/dist/bin/next','dev','--port',process.env.PORT||'3000','--hostname',process.env.FIGMA_DEV_SERVER_HOST||'0.0.0.0']; spawn(process.execPath,args,{stdio:'inherit',env:{...process.env,NODE_OPTIONS:((process.env.NODE_OPTIONS||'')+' --no-deprecation').trim()}}).on('exit',c=>process.exit(c??0))\"",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload build",
    "build:web": "next build",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" next start",
    "format": "oxfmt",
    "generate:importmap": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload generate:importmap",
    "generate:types": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload generate:types",
    "payload": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@payloadcms/figma": "1.0.0-beta.4",
    "@payloadcms/next": "4.0.0-beta.11",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.11",
    "@payloadcms/plugin-mcp": "4.0.0-beta.11",
    "@payloadcms/richtext-lexical": "4.0.0-beta.11",
    "@payloadcms/translations": "4.0.0-beta.11",
    "@payloadcms/ui": "4.0.0-beta.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "payload": "4.0.0-beta.11",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
