# Firebase Web App Config (Project: niva-421c2, safe for Web SDK & Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=niva-421c2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://niva-421c2-default-rtdb.asia-southeast1.firebasedatabase.app
